<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Legacy storage permission for older devices (<= Android 12L / some scenarios) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Android 11+ full file access; Google Play submission requires a separate
         use-case declaration. Self-built / sideloaded installs can use it directly. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- FTP and other network filesystems -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- WiFi sharing (built-in HTTP/WebDAV server):
         - ACCESS_WIFI_STATE: get a WifiManager to take WiFi / multicast locks;
         - CHANGE_WIFI_MULTICAST_STATE: device discovery listens on broadcast UDP,
           packets get dropped in power-save mode without this;
         - WAKE_LOCK: keep CPU awake during an in-flight transfer (released when
           idle, see WebShare).
         All normal level, granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Tapping an apk to launch the installer directly (Android 8+ requires
         this; without it the "install unknown apps" toggle doesn't apply to us) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- "Uninstall" from the app management screen: on Android 8+ the system
         uninstall UI verifies the caller has declared this permission, otherwise
         it just finishes silently — symptoms: tap uninstall, nothing happens
         (no error, no dialog). Normal-level permission, granted at install, no
         runtime request needed. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Music background playback: foreground service + notification (Android 13+
         the notification requires runtime permission, denying it doesn't affect playback) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Silent remote command execution (CmdService): a command may run for
         minutes, the process must not be reaped -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Fingerprint unlock (optional shortcut for the master password, API 28+).
         Normal permission, granted at install, no runtime request needed. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Apps management (the "Apps" root in the tree): enumerate all installed
         apps on the device. Without it on Android 11+ getInstalledApplications
         returns only this app plus whatever's in <queries> below — the list is
         effectively empty. Google Play treats this as a sensitive permission
         and requires a separate "file manager" use-case declaration; sideloaded
         installs are unaffected. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Shizuku: run a privileged process under shell (Settings → "Privileged access").
         This is a Shizuku-defined permission, granted by Shizuku's manager — not a system runtime permission. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Android 11+ package visibility: query the default handler for a given
         type (so file icons can show the associated app icon) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- ★ Without this declaration, on targetSdk 30+ Shizuku's
             pingBinder / version-query always fails — symptom is "Shizuku is
             installed but the app says it's not" — package visibility keeps
             it out of our view entirely. -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".TwigApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@drawable/ic_launcher"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Twig">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/action_settings" />

        <activity
            android:name=".ui.TextViewerActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.HexViewerActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.PdfViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.ImageViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.GitActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- Independent task stack: its own card in recents, can be switched /
             split-screened with the file manager; the session is held resident
             by TermHolder -->
        <activity
            android:name=".ui.TerminalActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.twig.app.terminal"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/terminal_menu" />

        <activity
            android:name=".ui.DiffActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.HexCompareActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/compare_hex_diff" />

        <activity
            android:name=".ui.ImageCompareActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/compare_image_diff" />

        <activity
            android:name=".ui.CompareActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/compare_title" />

        <activity
            android:name=".ui.MediaPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.MusicPlayerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/music_title" />

        <activity
            android:name=".ui.PlaylistActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/music_playlists" />

        <!-- Music background-playback foreground service -->
        <service
            android:name=".ui.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- "Open with Twig": catches other apps' ACTION_VIEW and routes to the
             internal viewer / archive mount. Headless relay (transparent theme),
             finishes immediately after dispatching. Only registers the MIME types
             the internal viewers actually support — never claim */*, or Twig
             would appear in the "open with" list for every file. -->
        <activity
            android:name=".ui.ViewIntentActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Twig.Translucent">
            <!-- text / image / audio / video -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- Mountable archives (zip/jar/7z/rar, see Archives) plus text
                 formats usually classified as application/* -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/xhtml+xml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/x-sh" />
            </intent-filter>
            <!-- PDF: opened by the built-in reader (PdfViewerActivity). Its own
                 filter rather than a line in the one above, because a PDF is
                 neither an archive to mount nor text — and because a caller may
                 hand us a provider that cannot seek, which PdfDoc.open handles by
                 materialising to the cache. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Desktop shortcut for a single file (see PaneFragment.pinFileOpenShortcut /
             OpenShortcutActivity): headless relay, reconnects the source if needed and
             dispatches straight to the chosen viewer, then finishes. Not exported — the
             system launches pinned shortcuts without needing that, and this intent carries
             an internal scheme+path that can point at a private server (same reasoning as
             TerminalActivity above).
             ★ Its own taskAffinity, distinct from MainActivity's (default = package name):
             without one, launching this (with FLAG_ACTIVITY_NEW_TASK, see
             OpenShortcutActivity.intent) lands on top of Twig's *existing* task if one is
             already in Recents — MainActivity flashes on screen before the viewer covers it,
             and pressing back in the viewer pops to MainActivity instead of exiting. A
             separate affinity guarantees a fresh, isolated task every time. -->
        <activity
            android:name=".ui.OpenShortcutActivity"
            android:exported="false"
            android:taskAffinity="com.twig.app.shortcut"
            android:label="@string/app_name"
            android:theme="@style/Theme.Twig.Translucent" />

        <!-- Receives images/files shared from other apps ("Copy to Twig…"),
             pops the directory picker -->
        <activity
            android:name=".ui.ShareTargetActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/copy_to">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Entry point for home-screen command shortcuts (headless relay:
             decides terminal vs. background service) -->
        <activity
            android:name=".ui.RunCommandActivity"
            android:exported="true"
            android:label="@string/cmd_shortcut"
            android:theme="@style/Theme.Twig.Translucent" />

        <!-- Foreground service for silent remote command execution
             (commands may run for minutes, must not be reaped with the process) -->
        <service
            android:name=".ui.CmdService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Copy / move / compress foreground service: progress goes to the
             notification, the dialog can be dismissed to background, the process
             is not reaped -->
        <service
            android:name=".ui.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- WiFi sharing: HTTP/WebDAV server and UDP discovery replies both
             run in this process — it must not be reaped during a sharing session
             (possibly hours idle), or the file in transit on the LAN just drops -->
        <service
            android:name=".share.ShareService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- File picker: when another app sends GET_CONTENT, Twig shows up in
             the list (result is a StreamProvider content:// with a temporary
             read grant); in-app font / colour / private-key imports also reuse
             this page — the win is being able to pick files from SMB/FTP/inside
             archives, which SAF can't see. -->
        <activity
            android:name=".ui.PickerActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/picker_title">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- "Open with another app": streaming expose any source as a content://
             URI, accessed via a grant -->
        <provider
            android:name=".StreamProvider"
            android:authorities="${applicationId}.stream"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Shizuku handshake: it hands its binder in through this provider.
             exported must be true (cross-process); the permission attribute
             keeps other callers out.
             multiprocess must be false — multiple processes each get a
             disjoint binder instance. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Make AppCompatDelegate.setApplicationLocales() auto-persist on
             Android < 13 and apply the language choice before Activity.onCreate
             (otherwise every cold start flashes the system language first). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
