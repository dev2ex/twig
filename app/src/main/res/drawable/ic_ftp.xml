    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24"
    android:tint="@color/primary">
    <!-- Source directory, upper left -->
    <path android:fillColor="@android:color/white"
        android:pathData="M1.8,1.4h2.69l1.2,1.9h4.51a1.2,1.2 0 0,1 1.2,1.2v4.9a1.2,1.2 0 0,1 -1.2,1.2H1.8a1.2,1.2 0 0,1 -1.2,-1.2V2.6a1.2,1.2 0 0,1 1.2,-1.2z" />
    <!-- Target directory, lower right -->
    <path android:fillColor="@android:color/white"
        android:pathData="M13.8,13.4h2.69l1.2,1.9h4.51a1.2,1.2 0 0,1 1.2,1.2v4.9a1.2,1.2 0 0,1 -1.2,1.2H13.8a1.2,1.2 0 0,1 -1.2,-1.2V14.6a1.2,1.2 0 0,1 1.2,-1.2z" />
    <!-- The transfer: an elbow from the first directory down into the second -->
    <path android:strokeColor="@android:color/white"
        android:strokeWidth="2" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M13.2,4.2h4.6v5.2" />
