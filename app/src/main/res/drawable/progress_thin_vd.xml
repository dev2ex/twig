<?xml version="1.0" encoding="utf-8"?>
<!--
  Thin progress bar graphic: a single segment spanning the viewport width; the group's
  scaleX decides how long it is and translateX decides where it is. **Just this segment,
  no track** — the system's indeterminate bar comes with a built-in 30% track that, when
  pressed against the same-colored title bar bottom, shows as a faint band that cannot be
  hidden on its own.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="360dp"
    android:height="2dp"
    android:viewportWidth="360"
    android:viewportHeight="1">
    <group
        android:name="bar"
        android:pivotX="0"
        android:scaleX="0.08"
        android:translateX="-80">
        <path
            android:name="seg"
            android:fillColor="@color/accent"
            android:pathData="M0,0h360v1h-360z" />
    </group>
</vector>
