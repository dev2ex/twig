<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:titleTextAppearance="@style/CompactToolbarTitle"
        android:background="@color/toolbar"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_up" />

    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bar"
        android:visibility="gone">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:background="@null"
            android:hint="@string/viewer_search"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/search_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/search_prev"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▲"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/search_next"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▼"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/search_close"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✕"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!--
      正文区。★ 转圈的那个框浮在这一层里(FrameLayout),不再作为 LinearLayout 的一个
      兄弟节点占位置——保存时它一出现就把整篇正文往下顶一截、存完又弹回来,眼睛看到的
      是"存一次跳两下"。
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.twig.app.ui.CodeScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <HorizontalScrollView
                android:id="@+id/hscroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <!--
                  查看器用 EditText 而不是 TextView:只读态靠代码里 keyListener=null 实现
                  (仍可选中/复制,但不弹键盘、不显光标),编辑态把 keyListener 还回去即可,
                  免去两套视图与文本二次搬运。文本始终以 EDITABLE 持有——见 Activity 里
                  applyTheme() 的注释(先建 Spannable 再 setText 会触发万级 span 拷贝)。
                  背景置空,外观与原来的 TextView 一致。
                  CodeEditText 只做一件事:wrap_content 的宽度上多留一个光标位,免得行尾
                  光标被框架夹到最后一个字上(见该类注释)。
                -->
                <com.twig.app.ui.CodeEditText
                    android:id="@+id/content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:importantForAutofill="no"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </HorizontalScrollView>
        </com.twig.app.ui.CodeScrollView>

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 载入/保存的转圈:居中浮在正文之上,不参与上面那条竖直排布 -->
        <FrameLayout
            android:id="@+id/loading_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_overlay"
            android:padding="18dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/loading"
                style="?android:attr/progressBarStyle"
                android:layout_width="36dp"
                android:layout_height="36dp" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
