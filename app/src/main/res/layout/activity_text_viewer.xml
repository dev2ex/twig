<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:titleTextAppearance="@style/CompactToolbarTitle"
        android:background="@color/toolbar"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_up" />

    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bar"
        android:visibility="gone">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:background="@null"
            android:hint="@string/viewer_search"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/search_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/search_prev"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▲"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/search_next"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▼"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/search_close"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✕"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!--
      Body area. ★ The loading spinner floats on this layer (FrameLayout) and is no
      longer a sibling of the LinearLayout taking a slot — when saving it appears and
      pushes the whole body down a bit, then pops back up, so to the eye the page
      "jumps twice per save".
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.twig.app.ui.CodeScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!--
                  Line-number gutter: layout_height="match_parent" stretches it to the
                  content column's height — a horizontal LinearLayout's *cross* axis
                  (height) is not subject to the "match_parent child of a wrap_content
                  parent" clamp, only its main axis (width) is, so this is a normal,
                  well-supported case. Sharing this LinearLayout with the content column
                  means both scroll together as one unit inside the outer ScrollView —
                  no separate scroll sync is needed. See LineNumberGutter's kdoc.
                -->
                <com.twig.app.ui.LineNumberGutter
                    android:id="@+id/line_numbers"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />

                <HorizontalScrollView
                    android:id="@+id/hscroll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <!--
                      The viewer uses EditText, not TextView: read-only mode is implemented by
                      setting keyListener=null in code (selection / copy still work, but no
                      soft keyboard and no caret), and edit mode simply restores the
                      keyListener — avoiding two separate views and a second copy of the text.
                      The text is always held as EDITABLE — see the applyTheme() comment in
                      the Activity (building a Spannable first then setText would trigger
                      thousands of span copies). The background is null, so the appearance
                      matches the original TextView.
                      CodeEditText does only one thing: on a wrap_content width, leave room
                      for one extra cursor position so the line-end caret is not clamped to
                      the last character by the framework (see that class's comment).
                    -->
                    <com.twig.app.ui.CodeEditText
                        android:id="@+id/content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:background="@null"
                        android:fontFamily="monospace"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:importantForAutofill="no"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </HorizontalScrollView>
            </LinearLayout>
        </com.twig.app.ui.CodeScrollView>

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Load / save spinner: floats centered above the body, not part of the vertical stack above -->
        <FrameLayout
            android:id="@+id/loading_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_overlay"
            android:padding="18dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/loading"
                style="?android:attr/progressBarStyle"
                android:layout_width="36dp"
                android:layout_height="36dp" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
