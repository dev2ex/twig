<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:titleTextAppearance="@style/CompactToolbarTitle"
        android:background="@color/toolbar"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_up" />

    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bar"
        android:visibility="gone">

        <!-- Two interpretations: text and HEX, switched by a tap; both search the same byte stream -->
        <TextView
            android:id="@+id/search_mode"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="48dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:background="?attr/selectableItemBackground" />

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@null"
            android:hint="@string/viewer_search"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/search_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/search_prev"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▲"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/search_next"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▼"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/search_close"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✕"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none" />

        <!--
          Self-drawn fast scroll bar: RecyclerView's native scrollbar is neither
          draggable nor accurate at huge scales (hundreds of millions of lines overflow
          the computed range). Here the thumb height is fixed and its position is mapped
          only from "first visible row / total rows", independent of file size — so a
          10GB file still scrolls in one drag.
        -->
        <com.twig.app.ui.FastScrollBar
            android:id="@+id/fastscroll"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:layout_gravity="end" />

        <TextView
            android:id="@+id/drag_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="30dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_overlay"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/loading"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
