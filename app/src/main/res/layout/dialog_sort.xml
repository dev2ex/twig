<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_by"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:paddingTop="6dp"
            android:paddingBottom="4dp" />

        <RadioGroup
            android:id="@+id/rg_by"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rb_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/sort_name" />
            <RadioButton android:id="@+id/rb_size" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/sort_size" />
            <RadioButton android:id="@+id/rb_ext" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/sort_ext" />
            <RadioButton android:id="@+id/rb_date" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/sort_date" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cb_reversed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_reversed" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_folders_by"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <RadioGroup
            android:id="@+id/rg_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rf_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/sort_name" />
            <RadioButton android:id="@+id/rf_date_old" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/sort_date_old" />
            <RadioButton android:id="@+id/rf_date_new" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/sort_date_new" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
