<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="52dp"
    android:layout_height="match_parent"
    android:background="@color/bar"
    android:orientation="vertical">

    <!-- Top fixed area: when the Toolbar is hidden in landscape, the buttons that were
         on its right (terminal/music/swap panels/menu) move here and do not scroll with
         the action strip below. In portrait MainActivity sets the whole block GONE. -->
    <com.twig.app.ui.StripGrid
        android:id="@+id/as_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout android:id="@+id/as_term" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_terminal"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_term" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_music" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_music_note"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/music_menu" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_swap" style="@style/StripItem">
            <ImageView android:id="@+id/as_swap_icon" style="@style/StripIcon"
                android:src="@drawable/ic_pane_to_right"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_swap" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_menu" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_more_vert"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_menu" />
        </LinearLayout>
    </com.twig.app.ui.StripGrid>

    <View
        android:id="@+id/as_top_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

    <!-- Column count is set in code based on orientation (1 column in portrait, 2 in
         landscape — see MainActivity.applyStripColumns); entries fill row by row, and
         0dp + columnWeight=1 makes each column the same width. -->
    <com.twig.app.ui.StripGrid
        android:id="@+id/as_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="1"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/as_up" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_up"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_up" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_sort" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_sort"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/action_sort" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_refresh" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_refresh"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_refresh" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_new_folder" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_new_folder"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_new_folder" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_copy" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_copy"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_copy" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_move" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_move"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_move" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_compress" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_compress"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_compress" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_rename" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_rename"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_rename" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_delete" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_delete"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_delete" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_compare" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_compare"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_compare" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_map" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_treemap"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_map" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_search" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_search"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_search" />
        </LinearLayout>

        <LinearLayout android:id="@+id/as_history" style="@style/StripItem">
            <ImageView style="@style/StripIcon" android:src="@drawable/ic_history"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_history" />
        </LinearLayout>

        <!-- WiFi sharing: the icon switches to a solid fan while the service is running
             (see MainActivity.syncShareIcon) -->
        <LinearLayout android:id="@+id/as_share" style="@style/StripItem">
            <ImageView android:id="@+id/as_share_icon" style="@style/StripIcon"
                android:src="@drawable/ic_share_wifi"
                android:contentDescription="@null" />
            <TextView style="@style/StripLabel" android:text="@string/strip_share" />
        </LinearLayout>
    </com.twig.app.ui.StripGrid>
    </ScrollView>
</LinearLayout>
