<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp">

        <!-- Source: name (single) or "N items" -->
        <TextView
            android:id="@+id/tv_src"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:ellipsize="middle"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="12dp"
            android:paddingEnd="0dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_destination_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/copy_to"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <include
            android:id="@+id/destination_picker"
            layout="@layout/view_destination_picker" />

        <TextView
            android:id="@+id/tv_dest_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/cb_source_directory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/compress_source_directory"
            android:textSize="14sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/cb_keep_structure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/transfer_keep_structure"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_structure_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="5"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        <CheckBox
            android:id="@+id/cb_preserve_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/transfer_preserve_permissions"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transfer_preserve_permissions_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        <CheckBox
            android:id="@+id/cb_move"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/copy_move_mode"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
