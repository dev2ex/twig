<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar"
        android:elevation="4dp"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <!-- 竖屏:单面板 + 操作列在对侧(左面板→右列,右面板→左列),横向滑动切换;
         横屏:双面板并排 + 操作列居中。可见性由 MainActivity.applyLayoutMode 控制 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <include
            android:id="@+id/strip_left"
            layout="@layout/action_strip"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/pane_a"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/strip_mid"
            layout="@layout/action_strip"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/pane_b"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone" />

        <include
            android:id="@+id/strip_right"
            layout="@layout/action_strip"
            android:layout_width="52dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- 剪贴板栏(有内容时才显示):横跨整个窗口而不在某一侧面板内,粘贴目标是
         **活动面板**的当前目录,切面板即换目标。分两行:上行信息(内容 + 关闭),
         下行操作(目标 + 移动 + 粘贴)——一行塞不下,挤成一排后按钮点不准 -->
    <LinearLayout
        android:id="@+id/clip_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bar"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_clip"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btn_clip_clear"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:padding="11dp"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/action_clip_clear" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 粘贴目标 = 本面板当前目录,跟着绿框走 -->
            <TextView
                android:id="@+id/tv_clip_dest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="start"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cb_clip_move"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="6dp"
                android:text="@string/strip_move"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_paste"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/clip_paste_bg"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/action_paste"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
