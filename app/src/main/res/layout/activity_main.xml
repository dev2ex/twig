<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar"
        android:elevation="4dp"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <!-- Portrait: single pane + action strip on the opposite side (left pane → right
         column, right pane → left column), swiped horizontally to switch. Landscape:
         dual panes side by side + action strip centered. Visibility controlled by
         MainActivity.applyLayoutMode. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <include
            android:id="@+id/strip_left"
            layout="@layout/action_strip"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/pane_a"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/strip_mid"
            layout="@layout/action_strip"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/pane_b"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone" />

        <include
            android:id="@+id/strip_right"
            layout="@layout/action_strip"
            android:layout_width="52dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Clipboard bar (visible only when there is content): spans the whole window rather
         than living inside one pane, and the paste target is the **active pane's** current
         directory — switching panes switches the target. Two rows: top row is info
         (content + close), bottom row is actions (target + move + paste). One row was
         not enough — squeezed onto one row the buttons became hard to tap accurately. -->
    <LinearLayout
        android:id="@+id/clip_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bar"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_clip"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btn_clip_clear"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:padding="11dp"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/action_clip_clear" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Paste target = current directory of this pane; follows the green frame -->
            <TextView
                android:id="@+id/tv_clip_dest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="start"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cb_clip_move"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="6dp"
                android:text="@string/strip_move"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_paste"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/clip_paste_bg"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/action_paste"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
