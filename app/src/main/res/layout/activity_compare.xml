<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Scan progress bar pressed against the inside bottom edge of the title bar.
         ★ elevation is raised to this FrameLayout — leaving it on the Toolbar would
         cover sibling progress bars that have no elevation -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolbar"
        android:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/toolbar"
            app:titleTextAppearance="@style/CompactToolbarTitle"
            app:subtitleTextAppearance="@style/CompactToolbarSubtitle"
            app:titleTextColor="@color/white"
            app:subtitleTextColor="#B3FFFFFF"
            app:navigationIcon="@drawable/ic_up" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/progress_thin_indet"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Same layout as the main screen's dual panes: each side has its own path bar
             (active side highlighted), with a column of status symbols in the middle.
             In portrait only one side is shown, but the status column stays. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/side_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@color/surface">

                <LinearLayout
                    android:id="@+id/path_bar_left"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="@color/path_bar_active"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/iv_path_left"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:tint="@color/white"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_path_left"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:ellipsize="start"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_left"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />
            </LinearLayout>

            <!--
              Middle column = the path-bar segment + the status column below. ★ All three
              must be wrapped together: simply using marginTop to dodge the path bar is
              not enough — that 1dp reveals the root layout's background color, which
              still shows as a (light) vertical line on the green path bar. Wrapping them
              makes the entire path-bar row a single solid color, with no seam.
            -->
            <LinearLayout
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Space-giving segment for both path bars. ★ Use path_bar_active, not
                     path_bar: in the dark theme these are different values (#3D3D3D /
                     #262626); hard-coding the latter makes this middle strip look the
                     same color as the inactive side, splitting visually from the
                     highlighted one. In the light theme they match, so it went unnoticed. -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="@color/path_bar_active" />

                <!-- Status column: one symbol per row (= same / ≠ different / ◀ ▶ only on
                     one side), aligned row-by-row with the two sides and scrolling along
                     with them. Even in portrait, when only one list is visible, it stays. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:background="@color/surface">

                    <View
                        android:id="@+id/divider"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list_state"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <View
                        android:id="@+id/divider2"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/side_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@color/surface">

                <LinearLayout
                    android:id="@+id/path_bar_right"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="@color/path_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/iv_path_right"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:tint="@color/white"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_path_right"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:ellipsize="start"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
