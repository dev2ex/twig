<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/twigSurface">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="?attr/twigToolbar"
        app:titleTextAppearance="@style/CompactToolbarTitle" app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/white" app:navigationIcon="@drawable/ic_up" />
    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/twigBar"
        android:visibility="gone">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:background="@null"
            android:hint="@string/viewer_search"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/search_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/search_prev"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▲"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/search_next"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▼"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/search_close"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✕"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp"
        android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <com.twig.app.ui.WebsiteWebView android:id="@+id/web" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ProgressBar android:id="@+id/pull_indicator" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp"
            android:visibility="gone" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:id="@+id/debug_host" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
