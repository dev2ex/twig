<?xml version="1.0" encoding="utf-8"?>
<!--
  One row = offset + hex + divider + chars. All three columns use a monospace font, and the byte count per row is fixed (computed by the Activity
  from the pane width), so the columns line up naturally with no horizontal scrolling. The hex column has weight=1 to absorb the slack,
  so **the chars column as a whole is pushed to the end of the row** (right-aligned); within the column the chars themselves are still gravity=start
  left-aligned — on the last row when bytes don't fill the line, the chars must line up with the previous row and cannot be squeezed right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/hex_row_pad_start"
    android:paddingEnd="@dimen/hex_row_pad_end">

    <TextView
        android:id="@+id/off"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <TextView
        android:id="@+id/hex"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="start"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <!-- Divider between the hex and chars columns; color follows the theme, applied in bindRow -->
    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp" />

    <TextView
        android:id="@+id/chars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1" />
</LinearLayout>
