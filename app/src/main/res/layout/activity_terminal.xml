<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="#B3FFFFFF"
        app:navigationIcon="@drawable/ic_up">

        <!-- Session switcher dropdown: sits in the title slot, picking one switches to it -->
        <Spinner
            android:id="@+id/session_spinner"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:popupBackground="@color/toolbar" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Outer wrapper around the terminal: freezes the terminal view's size when the
             screen is off or the app is backgrounded — see TermSizeFreezeLayout -->
    <com.twig.app.ui.TermSizeFreezeLayout
        android:id="@+id/terminal_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.termux.view.TerminalView
            android:id="@+id/terminal"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.twig.app.ui.TermSizeFreezeLayout>

    <!-- Extra-keys bar: control keys not present on a physical keyboard, two rows -->
    <LinearLayout
        android:id="@+id/extra_keys"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="vertical"
        android:background="#1A1A1A" />
</LinearLayout>
