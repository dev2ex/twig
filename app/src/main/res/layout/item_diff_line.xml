<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_no"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="4dp"
        android:paddingStart="0dp"
        android:typeface="monospace"
        android:textSize="10sp"
        android:textColor="@color/text_secondary" />

    <!--
      ★ 省略号只能在代码里关(见 DiffActivity.onCreateViewHolder)。XML 的
      android:ellipsize="none" 等于"没设",而 TextView 构造函数里有一句
      `if (singleLine && getKeyListener() == null && ellipsize 未设) ellipsize = END`
      ——**只读的单行 TextView 默认就是末尾省略**。排版是无限宽的(横滚滚得动),
      但绘制被省略号截断,于是"能滚却看不到后面"。
    -->
    <TextView
        android:id="@+id/tv_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:singleLine="true"
        android:typeface="monospace"
        android:textSize="11sp"
        android:textColor="@color/text_primary" />
</LinearLayout>
