<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_no"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="4dp"
        android:paddingStart="0dp"
        android:typeface="monospace"
        android:textSize="10sp"
        android:textColor="@color/text_secondary" />

    <!--
      ★ Ellipsis can only be disabled in code (see DiffActivity.onCreateViewHolder). XML's
      android:ellipsize="none" is equivalent to "not set", and the TextView constructor contains the line
      `if (singleLine && getKeyListener() == null && ellipsize not set) ellipsize = END`
      — **a read-only single-line TextView defaults to end ellipsis**. Layout has infinite width (horizontal scrolling works),
      but drawing is truncated by the ellipsis, leading to "can scroll but cannot see what comes after".
    -->
    <TextView
        android:id="@+id/tv_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:singleLine="true"
        android:typeface="monospace"
        android:textSize="11sp"
        android:textColor="@color/text_primary" />
</LinearLayout>
