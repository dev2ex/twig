<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the terminal's session dropdown: the session's own name on top, and below it
     the title the running program set via OSC (htop, ranger, a shell's PS1) — hidden when there is none. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/session_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#EEEEEE"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/session_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
