<?xml version="1.0" encoding="utf-8"?>
<!--
  对比行。形制照 item_file(展开箭头 + 26dp 图标 + 名字/大小时间 + 勾选),
  差别只有一处:**行高固定**——高度跟着内容走的话,某侧缺失或名字换行就会让两栏错位、
  同步滚动跟着失准。状态符号不在行里,单独占中间那一列(item_compare_state)。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingEnd="0dp">

    <View
        android:id="@+id/indent"
        android:layout_width="0dp"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/infoBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:gravity="end"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/check"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="8dp"
        android:src="@drawable/ic_sel_check"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_select" />
</LinearLayout>
