<?xml version="1.0" encoding="utf-8"?>
<!--
  Compare row. Shape follows item_file (expand arrow + 26dp icon + name/size-time + check),
  with one difference: **the row height is fixed** — if the height followed the content, a missing entry on one side or a wrapping name would throw the two columns out of alignment,
  and the synchronized scrolling would drift. The status symbol is not in the row; it occupies its own middle column (item_compare_state).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingEnd="0dp">

    <View
        android:id="@+id/indent"
        android:layout_width="0dp"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/infoBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:gravity="end"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/check"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="8dp"
        android:src="@drawable/ic_sel_check"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_select" />
</LinearLayout>
