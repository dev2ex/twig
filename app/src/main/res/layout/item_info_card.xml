<?xml version="1.0" encoding="utf-8"?>
<!-- Property card: the tab title bar is a small strip indented with the tree (aligned with the file row icon, like a tree node), and the content box fills left and right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-1dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/info_tab_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/info_card_bg">

        <!-- The directory recursive stats spinner sits in the bottom-right corner of the content box (right next to the two lines of numbers it describes).
             ★ It cannot go in the tab strip row: the tab strip is wrap_content with a marginStart that grows with tree depth,
             and in the narrower bottom pane of the two-pane layout, a deep hierarchy eats the whole row, so the fixed-width spinner is pushed past the right edge and clipped —
             visually it just looks like "no spinner". Stacking it inside the content box can't squeeze it out.
             ★ It also cannot be dynamically addView'd at bind time: the tab strip removeAllViews on every bind,
             so the spinner would be recreated on every scan-progress refresh, restarting its animation from scratch. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/info_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/scan_spin"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/btn_hash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/info_card_bg"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:text="@string/info_hash_compute"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
