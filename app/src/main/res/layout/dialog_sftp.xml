<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="0dp"
        android:focusableInTouchMode="true">
        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no"
            style="@style/ConnectionField"
            android:hint="@string/conn_name" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <EditText
                android:id="@+id/et_host"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:importantForAutofill="no"
                style="@style/ConnectionField"
                android:hint="@string/ftp_host"
                android:layout_weight="1"
                android:layout_marginEnd="8dp" />
            <EditText
                android:id="@+id/et_port"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="22"
                android:importantForAutofill="no"
                style="@style/ConnectionField"
                android:hint="@string/ftp_port" />
        </LinearLayout>
        <EditText
            android:id="@+id/et_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no"
            style="@style/ConnectionField"
            android:hint="@string/conn_path" />
        <TextView
            android:text="@string/conn_section_login"
            style="@style/ConnectionSection" />
        <EditText
            android:id="@+id/et_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no"
            style="@style/ConnectionField"
            android:hint="@string/ftp_user" />
        <EditText
            android:id="@+id/et_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:importantForAutofill="no"
            style="@style/ConnectionField"
            android:hint="@string/sftp_pass_hint" />
        <TextView
            android:text="@string/conn_section_options"
            style="@style/ConnectionSection" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/et_key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:importantForAutofill="no"
                style="@style/ConnectionField"
                android:hint="@string/sftp_key"
                android:layout_weight="1" />
            <Button
                android:id="@+id/btn_pick_key"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sftp_pick_key" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
