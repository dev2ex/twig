<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/et_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/conn_name"
        android:inputType="text"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/et_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ftp_host"
        android:inputType="textUri"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/et_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ftp_port"
        android:inputType="number"
        android:text="22"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/et_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/conn_path"
        android:inputType="text"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/et_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ftp_user"
        android:inputType="text"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/et_pass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/sftp_pass_hint"
        android:inputType="textPassword"
        android:importantForAutofill="no" />

    <!-- Private key file (optional): after picking, copy into the app's private directory -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_key"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/sftp_key"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btn_pick_key"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sftp_pick_key" />
    </LinearLayout>
</LinearLayout>
