<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom title bar for the transfer-progress dialog (AlertDialog.setCustomTitle): title text + "Send to background" on the right.
  A custom title rather than putting the button inside the content area is used because the button belongs at the right end of the title row;
  padding is copied from the AppCompat default title (left/right dialogPreferredPadding), so swapping it in shows no seam.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="?attr/dialogPreferredPadding"
    android:paddingEnd="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.AppCompat.Title"
        android:textColor="@color/text_primary" />

    <!-- Tap to collapse the progress dialog; the transfer keeps running in the foreground service (tap the notification progress bar to bring it back) -->
    <ImageView
        android:id="@+id/btn_background"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:padding="10dp"
        android:src="@drawable/ic_chevron_down"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/transfer_background" />
</LinearLayout>
