<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="0dp"
        android:focusableInTouchMode="true">
        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no"
            style="@style/ConnectionField"
            android:hint="@string/conn_name" />
        <EditText
            android:id="@+id/et_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:importantForAutofill="no"
            style="@style/ConnectionField"
            android:hint="@string/smb_host" />
        <EditText
            android:id="@+id/et_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no"
            style="@style/ConnectionField"
            android:hint="@string/smb_share" />
        <TextView
            android:text="@string/conn_section_login"
            style="@style/ConnectionSection" />
        <EditText
            android:id="@+id/et_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:text="guest"
            android:importantForAutofill="no"
            style="@style/ConnectionField"
            android:hint="@string/ftp_user" />
        <EditText
            android:id="@+id/et_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:importantForAutofill="no"
            style="@style/ConnectionField"
            android:hint="@string/ftp_pass" />
        <TextView
            android:text="@string/conn_section_options"
            style="@style/ConnectionSection" />
        <EditText
            android:id="@+id/et_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no"
            style="@style/ConnectionField"
            android:hint="@string/smb_domain" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/smb1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/smb1_mode"
            android:layout_marginTop="8dp"
            android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
