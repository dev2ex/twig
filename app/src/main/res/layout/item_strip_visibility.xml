<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center_vertical">
    <ImageView android:id="@+id/drag_handle"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:padding="12dp" android:src="@drawable/ic_drag_handle"
        android:contentDescription="@string/root_drag_to_reorder"
        android:tint="?android:attr/textColorSecondary" />
    <ImageView android:id="@+id/icon"
        android:layout_width="24dp" android:layout_height="24dp"
        android:importantForAccessibility="no" android:tint="@color/primary" />
    <TextView android:id="@+id/label"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="12dp"
        android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" />
    <CheckBox android:id="@+id/visible"
        android:layout_width="48dp" android:layout_height="48dp"
        android:buttonTint="?attr/colorAccent" />
</LinearLayout>
