<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.twig.app.ui.ZoomableImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null" />

    <!-- Loading spinner in the top-right corner: shown during navigation / autoplay, does not obscure the current image -->
    <ProgressBar
        android:id="@+id/loading"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:indeterminateTint="@color/white"
        android:visibility="gone" />

    <!-- Floating top bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="#88000000"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_up" />

    <!-- Floating bottom bar -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#88000000"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            android:tint="@color/white"
            android:contentDescription="@null" />

        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_play"
            android:tint="@color/white"
            android:contentDescription="@string/slideshow" />

        <ImageButton
            android:id="@+id/btn_shuffle"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/white"
            android:contentDescription="@string/shuffle" />

        <ImageButton
            android:id="@+id/btn_fit"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_fit_rotate"
            android:tint="@color/white"
            android:contentDescription="@string/rotate_fit" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/white"
            android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>
