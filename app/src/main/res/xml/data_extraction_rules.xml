<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份/迁移规则(android:dataExtractionRules)。
  两条通道都要各写一遍:cloud-backup(云备份)与 device-transfer(换机直传)。
  排除项与 backup_rules.xml 保持一致,改一处记得改另一处。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="twig_connections.xml" />
        <exclude domain="sharedpref" path="twig_restic_pw.xml" />
        <exclude domain="file" path="keys/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="twig_connections.xml" />
        <exclude domain="sharedpref" path="twig_restic_pw.xml" />
        <exclude domain="file" path="keys/" />
    </device-transfer>
</data-extraction-rules>
