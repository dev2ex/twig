<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / migration rules for Android 12+ (android:dataExtractionRules).
  Both channels must be listed separately: cloud-backup and device-transfer.
  Exclusions must stay in sync with backup_rules.xml — when you change one,
  change the other too.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="twig_connections.xml" />
        <exclude domain="sharedpref" path="twig_restic_pw.xml" />
        <exclude domain="sharedpref" path="twig_archive_pw.xml" />
        <exclude domain="sharedpref" path="twig_share.xml" />
        <exclude domain="sharedpref" path="twig_websites.xml" />
        <exclude domain="file" path="keys/" />
        <exclude domain="file" path=".ssh/" />
        <exclude domain="sharedpref" path="twig_stream.xml" />
        <exclude domain="sharedpref" path="twig_launcher_shortcuts.xml" />
        <!-- Website login data stays on this device. -->
        <exclude domain="root" path="app_webview/" />
        <!-- User files in Private space stay on this device. -->
        <exclude domain="root" path="private_space/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="twig_connections.xml" />
        <exclude domain="sharedpref" path="twig_restic_pw.xml" />
        <exclude domain="sharedpref" path="twig_archive_pw.xml" />
        <exclude domain="sharedpref" path="twig_share.xml" />
        <exclude domain="sharedpref" path="twig_websites.xml" />
        <exclude domain="file" path="keys/" />
        <exclude domain="file" path=".ssh/" />
        <exclude domain="sharedpref" path="twig_stream.xml" />
        <exclude domain="sharedpref" path="twig_launcher_shortcuts.xml" />
        <!-- Website login data stays on this device. -->
        <exclude domain="root" path="app_webview/" />
        <!-- User files in Private space stay on this device. -->
        <exclude domain="root" path="private_space/" />
    </device-transfer>
</data-extraction-rules>
