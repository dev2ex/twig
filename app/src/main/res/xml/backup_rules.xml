<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 11 and below (android:fullBackupContent).

  By default the full-backup package would include everything under the app's
  private directory — including saved server passwords and SFTP private keys.
  Once those land in an `adb backup` or a cloud backup, they escape the
  "only-this-app-can-read" sandbox: on Android <= 11 `adb backup` can pull
  them straight to a computer in cleartext.
  Credentials are excluded unconditionally; losing them just means re-typing,
  leaking them means rotating every server password.

  API 31+ uses data_extraction_rules.xml — keep the two in sync.
-->
<full-backup-content>
    <!-- Server connections: host/user/password in plaintext JSON -->
    <exclude domain="sharedpref" path="twig_connections.xml" />
    <!-- Restic repository password -->
    <exclude domain="sharedpref" path="twig_restic_pw.xml" />
    <!-- Imported SFTP private keys (MainActivity's key picker copies them here) -->
    <exclude domain="file" path="keys/" />
</full-backup-content>
