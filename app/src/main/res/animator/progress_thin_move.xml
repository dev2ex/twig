<?xml version="1.0" encoding="utf-8"?>
<!-- A thin bar sweeps from left to right, stretching out then narrowing along the way — same feel as the system indeterminate progress, not a "filling" bar -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:propertyName="translateX"
        android:valueFrom="-80"
        android:valueTo="360"
        android:valueType="floatType"
        android:duration="1600"
        android:repeatCount="infinite"
        android:interpolator="@android:interpolator/accelerate_decelerate" />
    <objectAnimator
        android:propertyName="scaleX"
        android:valueFrom="0.08"
        android:valueTo="0.42"
        android:valueType="floatType"
        android:duration="800"
        android:repeatCount="infinite"
        android:repeatMode="reverse" />
</set>
