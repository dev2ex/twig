<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Based on AppCompat DayNight (follows system / manual dark, no Material library) -->
    <style name="Theme.Twig" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="twigBg">@color/palette_bg</item>
        <item name="twigSurface">@color/palette_surface</item>
        <item name="twigBar">@color/palette_bar</item>
        <item name="twigToolbar">@color/palette_toolbar</item>
        <item name="twigPrimaryDark">@color/palette_primary_dark</item>
        <item name="twigDivider">@color/palette_divider</item>
        <item name="twigPathBarActive">@color/palette_path_bar_active</item>
        <item name="twigPathBar">@color/palette_path_bar</item>
        <item name="twigPdfBackdrop">@color/palette_pdf_backdrop</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">?attr/twigPrimaryDark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/twig_text_primary</item>
        <item name="android:editTextStyle">@style/TwigEditText</item>
        <item name="editTextStyle">@style/TwigEditText</item>
        <!-- Floating dialogs sit slightly above the surface in the dark palette. -->
        <item name="android:colorBackgroundFloating">@color/palette_dialog</item>
        <item name="colorBackgroundFloating">@color/palette_dialog</item>
        <item name="android:windowBackground">?attr/twigBg</item>
        <item name="android:statusBarColor">?attr/twigToolbar</item>
    </style>

    <!-- OLED keeps large surfaces unlit; text brightness and borders retain hierarchy. -->
    <style name="Theme.Twig.Oled" parent="Theme.Twig">
        <!-- Older PhoneWindow versions require a resource reference for the window background. -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="twigBg">#000000</item>
        <item name="twigSurface">#000000</item>
        <item name="twigBar">#000000</item>
        <item name="twigToolbar">#000000</item>
        <item name="twigPrimaryDark">#000000</item>
        <item name="twigDivider">#202020</item>
        <item name="twigPathBarActive">#000000</item>
        <item name="twigPathBar">#000000</item>
        <item name="twigPdfBackdrop">#000000</item>
        <item name="popupMenuStyle">@style/TwigOledPopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/TwigOledPopupMenu</item>
        <item name="android:popupMenuStyle">@style/TwigOledPlatformPopupMenu</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorBackgroundFloating">#000000</item>
        <item name="colorBackgroundFloating">#000000</item>
    </style>

    <style name="TwigOledPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@android:color/black</item>
    </style>

    <style name="TwigOledPlatformPopupMenu" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@android:color/black</item>
    </style>

    <style name="Theme.Twig.Oled.Translucent" parent="Theme.Twig.Oled">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Side action column item: icon + small label, X-plore style -->
    <!--
        Used by the headless relay screens (ViewIntentActivity / RunCommandActivity).
        They don't display anything themselves, but **need to be able to pop up the unlock dialog** — AppCompat's AlertDialog requires
        the host to be an AppCompat theme; the platform's Theme.Translucent doesn't satisfy it, and it crashes the moment a dialog is shown.
    -->
    <style name="Theme.Twig.Translucent" parent="Theme.Twig">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="StripItem">
        <!-- Parent container is GridLayout: 0dp + columnWeight makes every column equal width (fills when there is only 1 column) -->
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="StripIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:tint">@color/primary</item>
    </style>

    <style name="StripLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:singleLine">true</item>
    </style>

    <!--
      Every **Toolbar with a subtitle** should use this pair (compare / text compare / image compare / Git).
      If left unset, it falls back to Theme.AppCompat's default TextAppearance.Widget.AppCompat.Toolbar.Title
      (20sp) — portrait actionBarSize is 56dp, so a 20sp title + 14sp subtitle fit on two lines and look
      very large; landscape only has 48dp, so the same two lines get squished, leading to "large text in portrait, normal in landscape". These sizes are fixed
      at the moment Toolbar builds its title view, and rotation does not redo them. Just set the sizes explicitly.
    -->
    <style name="CompactToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CompactToolbarSubtitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:textSize">11sp</item>
    </style>
</resources>
